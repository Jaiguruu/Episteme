      "symbol_id": "sym_7ff206bc122fb996",
      "text": "\"\"\"Payment domain model.\n\nFixture file for the MAAT offline pipeline (Problem_doc.md section 7).\n\"\"\"\n\n\nclass Payment:\n    \"\"\"A single payment.\"\"\"\n\n    def __init__(self, amount: float, currency: str = \"USD\") -> None:\n        self.amount = amount\n        self.currency = currency",
      "token_count": 69
    },
    {
      "chunk_type": "imports",
      "embedding_id": null,
      "id": "chunk_782ef82702f3c492",
      "model_version": "mv_9abbbfdfc700ea1e",
      "symbol_id": "sym_b44a5c810e00d25f",
      "text": "(no imports)",
      "token_count": 3
    },
    {
      "chunk_type": "module",
      "embedding_id": null,
      "id": "chunk_35cc6ef8cc462b63",
      "model_version": "mv_9abbbfdfc700ea1e",
      "symbol_id": "sym_b44a5c810e00d25f",
      "text": "\"\"\"Refund handling.\n\nSecond caller of PaymentService, which is what makes\n``find_callers(PaymentService)`` return two results rather than one.\n\"\"\"\n\nfrom models.payment import Payment\nfrom repositories.payment_repository import PaymentRepository\nfrom services.payment_service import PaymentService\n\n\nclass RefundService:\n    \"\"\"Issues refunds through the payment service.\"\"\"\n\n    def __init__(self) -> None:\n        self.payment_service = PaymentService(PaymentRepository())\n\n    def refund(self, payment: Payment) -> bool:\n        \"\"\"Process a refund as a negative payment.\"\"\"\n        return self.payment_service.process(payment)",
      "token_count": 157
    },
    {
      "chunk_type": "imports",
      "embedding_id": null,
      "id": "chunk_97eef7fe89d83871",
      "model_version": "mv_9abbbfdfc700ea1e",
      "symbol_id": "sym_fa8c383a7bead8c5",
      "text": "(no imports)",
      "token_count": 3
    },
    {
      "chunk_type": "module",
      "embedding_id": null,
      "id": "chunk_f5959b07039d8c03",
      "model_version": "mv_9abbbfdfc700ea1e",
      "symbol_id": "sym_fa8c383a7bead8c5",
      "text": "\"\"\"Checkout orchestration.\"\"\"\n\nfrom models.payment import Payment\nfrom repositories.payment_repository import PaymentRepository\nfrom services.payment_service import PaymentService\n\n\nclass CheckoutService:\n    \"\"\"Turns a cart into a payment.\"\"\"\n\n    def __init__(self) -> None:\n        self.payment_service = PaymentService(PaymentRepository())\n\n    def checkout(self, cart) -> bool:\n        \"\"\"Create a payment and hand it to the payment service.\"\"\"\n        payment = Payment(cart.total)\n        return self.payment_service.process(payment)",
      "token_count": 135
    },
    {
      "chunk_type": "imports",
      "embedding_id": null,
      "id": "chunk_931fc101120a7499",
      "model_version": "mv_9abbbfdfc700ea1e",
      "symbol_id": "sym_feaa8b282d322d38",
      "text": "(no imports)",
      "token_count": 3
    },
    {
      "chunk_type": "module",
      "embedding_id": null,
      "id": "chunk_1b9d4430d980cd8e",
      "model_version": "mv_9abbbfdfc700ea1e",
      "symbol_id": "sym_feaa8b282d322d38",
      "text": "\"\"\"HTTP entry point for checkout.\"\"\"\n\nfrom services.checkout_service import CheckoutService\n\n\nclass CheckoutController:\n    \"\"\"Handles the checkout request.\"\"\"\n\n    def handle(self, request) -> bool:\n        \"\"\"Delegate the request to the checkout service.\"\"\"\n        service = CheckoutService()\n        return service.checkout(request.cart)",
      "token_count": 85
    }
